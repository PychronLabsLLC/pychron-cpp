#!/bin/sh
# Refuses a push while the C++ this branch changes has static analysis
# findings (tools/quality_check.py: cppcheck, then clang-tidy, on the lines
# that differ from origin/develop). CI does not run on develop, so this is the
# only place the check is made for work that lands there.
#
# Installed once per clone:  git config core.hooksPath tools/githooks
# A push that changes no C++ passes at once. `git push --no-verify` skips it;
# say why in the commit when you do.

root=$(git rev-parse --show-toplevel) || exit 0
# A branch cut before the checker existed has nothing to run.
[ -f "$root/tools/quality_check.py" ] || exit 0

python3 "$root/tools/quality_check.py"
status=$?
[ "$status" -eq 0 ] && exit 0

if [ "$status" -eq 1 ]; then
  echo "pre-push: findings on lines this branch changes (above). Fix them, or silence one" >&2
  echo "pre-push: on its line with the reason: // NOLINT(<check>): <why>" >&2
else
  echo "pre-push: the static analysis could not run (above). docs/dev_setup.md, 'Static analysis'," >&2
  echo "pre-push: has the setup: clang-tidy, cppcheck and a configured build directory." >&2
fi
exit 1
