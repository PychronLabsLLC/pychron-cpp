# Every text file is LF in a checkout on every platform: the TOML, CSV and
# template files are parsed by code that is not told about CRLF, and the
# Windows CI runner's git would otherwise convert them.
* text=auto eol=lf
*.pgm binary
# The vendor workbook templates (libs/earthbank/templates) are copied byte for byte.
*.xlsx binary
# Legacy fixtures are read byte for byte (hashes, git blob shas): never convert line endings.
tests/dvc/fixtures/** -text
# Legacy lab files kept with their CRLF line endings: the reader is tested against them.
tests/systems/data/** -text
# The SVG and PDF of a scene are compared byte for byte: never convert them.
tests/processing/fixtures/scene/** -text
tests/processing/fixtures/scene/*.pdf binary
