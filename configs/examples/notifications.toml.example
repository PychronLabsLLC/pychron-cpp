# Notifications for this lab: copy to notifications.toml and keep the
# channels you want. Each sends a message when a run fails (run_failed) and
# when the queue ends (queue_ended); `on` narrows that.
# Test with:  elctl exp notify --lab <this directory>
# Step-by-step setup: docs/notifications.md

# curl = "curl"     # the curl program used for email and webhooks
# timeout = 30      # seconds per delivery

# Email through a mail service (brevo, resend or postmark): one free account
# with the service, and its key in an environment variable.
# [[email]]
# provider = "brevo"
# api_key_env = "PYCHRON_MAIL_API_KEY"     # the key is read from this environment variable
# from = "pychron@example.org"             # a sender confirmed with the service
# to = ["lab-manager@example.org"]
# queue_user = true                        # also mail the queue's `email`
# on = ["run_failed", "queue_ended"]

# Email through an SMTP server.
# [[email]]
# url = "smtps://smtp.example.org:465"     # or smtp://host:587 (STARTTLS is required unless tls = false)
# from = "pychron@example.org"
# to = ["lab-manager@example.org"]
# username = "pychron@example.org"
# password_env = "PYCHRON_SMTP_PASSWORD"   # the password is read from this environment variable
# queue_user = true                        # also mail the queue's `email`
# on = ["run_failed", "queue_ended"]

# [[webhook]]
# name = "slack"
# url = "https://hooks.slack.com/services/T000/B000/XXXX"
# format = "slack"                         # {"text": ...}; "json" posts every field
# on = ["queue_ended"]

# [[command]]
# name = "pager"
# argv = ["/usr/local/bin/notify-lab"]     # message on stdin; PYCHRON_EVENT, PYCHRON_SUBJECT, PYCHRON_QUEUE, ...
